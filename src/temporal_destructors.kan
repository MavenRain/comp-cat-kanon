-- Generated exhaustive formula destructors.
def asAlways : (0 A : Type 0) -> Temporal A -> Result (Temporal A) :=
  fun (0 A : Type 0) (p : Temporal A) =>
  match p as self in Temporal return Result (Temporal A) with
  | tlTrue  => err (Temporal A) (illFormed textRule textRuleShape)
  | tlFalse  => err (Temporal A) (illFormed textRule textRuleShape)
  | tlState name pred => err (Temporal A) (illFormed textRule textRuleShape)
  | tlAction name pred => err (Temporal A) (illFormed textRule textRuleShape)
  | tlAnd left right => err (Temporal A) (illFormed textRule textRuleShape)
  | tlOr left right => err (Temporal A) (illFormed textRule textRuleShape)
  | tlNot body => err (Temporal A) (illFormed textRule textRuleShape)
  | tlImplies left right => err (Temporal A) (illFormed textRule textRuleShape)
  | tlLater body => err (Temporal A) (illFormed textRule textRuleShape)
  | tlNext body => err (Temporal A) (illFormed textRule textRuleShape)
  | tlAlways body => ok (Temporal A) (body)
  | tlEventually body => err (Temporal A) (illFormed textRule textRuleShape)
