def asImplies : (0 A : Type 0) -> Temporal A -> Result (prod (Temporal A, Temporal A)) :=
  fun (0 A : Type 0) (p : Temporal A) =>
  match p as self in Temporal return Result (prod (Temporal A, Temporal A)) with
  | tlTrue  => err (prod (Temporal A, Temporal A)) (illFormed textRule textRuleShape)
