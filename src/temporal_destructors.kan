  | tlAnd left right => err (prod (Temporal A, Temporal A)) (illFormed textRule textRuleShape)
  | tlOr left right => err (prod (Temporal A, Temporal A)) (illFormed textRule textRuleShape)
  | tlNot body => err (prod (Temporal A, Temporal A)) (illFormed textRule textRuleShape)
  | tlImplies left right => ok (prod (Temporal A, Temporal A)) (tuple (left, right))
  | tlLater body => err (prod (Temporal A, Temporal A)) (illFormed textRule textRuleShape)
  | tlNext body => err (prod (Temporal A, Temporal A)) (illFormed textRule textRuleShape)
